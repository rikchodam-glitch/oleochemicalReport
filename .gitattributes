* text=auto eol=lf
# Berkas batch WAJIB CRLF: cmd.exe tidak selalu menemukan label/goto pada berkas
# .bat berakhiran LF murni (terbukti 08/10/2026: berkas yang sama berbalas
# "The system cannot find the batch label specified - laragon_mati" saat LF,
# tetapi jalan normal saat CRLF). Tanpa baris ini git menuliskan .bat sebagai LF,
# sehingga start-report.bat/stop-report.bat di copy PROD kehilangan sebagian
# cabangnya tanpa pesan yang jelas.
*.bat text eol=crlf
*.cmd text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
